  }

  class AuditInput {
    <<interface>>
    +event_type string
    +actor_id number
    +content_type string
    +object_id string
    +metadata json
  }

  class AuditLog {
    <<Entity audit_auditlog>>
    +id number
    +event_type string
    +content_type string
    +object_id string
    +metadata json
    +created_at Date
  }
}

