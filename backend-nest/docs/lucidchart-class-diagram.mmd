namespace Application {
  class AppModule {
    <<Module>>
  }
}

namespace CommonPatterns {
  class ApiResponseBuilder {
    <<Builder>>
    -message string
    +withMessage(message) ApiResponseBuilder
    +build(data) ApiSuccessResponse
  }

  class ApiExceptionFilter {
    <<ExceptionFilter>>
    +catch(exception, host) void
    -extractMessage(raw) string
  }

  class DjangoPasswordAdapter {
    <<Adapter>>
    +encode(password) string
    +verify(password, encoded) boolean
  }

  class AuditableOperation {
    <<interface>>
    +execute(args) Promise
  }

  class AuditedServiceDecorator {
    <<Decorator>>
    -wrapped AuditableOperation
    -auditService AuditService
    -eventType string
    +execute(args) Promise
  }

  class ItineraryGeneratorFactory {
    <<Factory>>
    -config ConfigService
    +create() BaseItineraryGenerator
  }

  class ItineraryGenerationFacade {
    <<Facade>>
    -aiService AiService
    +generate(itinerary, userId) Promise~LlmJob~
  }

  class ApiSuccessResponse {
    <<interface>>
    +success boolean
    +message string
    +data T
  }

  class ApiErrorResponse {
    <<interface>>
    +success boolean
    +message string
    +errors unknown
  }
}

namespace Auth {
  class AuthModule {
    <<Module>>
  }

  class AuthController {
    <<Controller>>
    -auth AuthService
    -response ApiResponseBuilder
    +register(dto)
    +login(dto)
    +logout(user)
  }

  class AuthService {
    <<Service>>
    -users UsersService
    -jwt JwtService
    -passwords DjangoPasswordAdapter
    -audit AuditService
    +register(dto)
    +login(dto)
    +logout(userId)
    -buildPayload(user)
  }

  class JwtStrategy {
    <<PassportStrategy>>
    +validate(payload) AuthenticatedUser
  }

  class JwtAuthGuard {
    <<Guard>>
  }

  class CurrentUser {
    <<ParamDecorator>>
  }

  class RegisterDto {
    <<DTO>>
    +email string
    +password string
    +username string
    +display_name string
    +first_name string
    +last_name string
  }

  class LoginDto {
    <<DTO>>
    +email string
    +password string
  }

  class AuthenticatedUser {
    <<interface>>
    +id number
    +email string
    +username string
    +is_staff boolean
    +is_superuser boolean
  }
}

namespace Users {
  class UsersModule {
    <<Module>>
  }

  class UsersController {
    <<Controller>>
    -users UsersService
    -response ApiResponseBuilder
    +me(authUser)
    +updateMe(authUser, dto)
  }

  class UsersService {
    <<Service>>
    -users Repository~User~
    -passwords DjangoPasswordAdapter
    +findByEmail(email) Promise~User~
    +findById(id) Promise~User~
    +create(input) Promise~User~
    +update(id, dto) Promise~User~
    -generateUsername(email) Promise~string~
  }

  class UpdateUserDto {
    <<DTO>>
    +email string
    +username string
    +display_name string
    +first_name string
    +last_name string
    +avatar_url string
    +home_airport string
    +preferred_currency string
    +is_profile_complete boolean
  }

  class User {
    <<Entity users_user>>
    +id number
    +password string
    +last_login Date
    +is_superuser boolean
    +username string
    +first_name string
    +last_name string
    +email string
    +is_staff boolean
    +is_active boolean
    +date_joined Date
    +display_name string
    +avatar_url string
    +home_airport string
    +preferred_currency string
    +is_profile_complete boolean
    +created_at Date
    +updated_at Date
  }

  class RefreshToken {
    <<Entity users_refreshtoken>>
    +id number
    +token string
    +expires_at Date
    +revoked_at Date
    +created_at Date
  }
}

