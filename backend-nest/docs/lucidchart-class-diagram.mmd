namespace Itineraries {
  class ItinerariesModule {
    <<Module>>
  }

  class ItinerariesController {
    <<Controller>>
    -itineraries ItinerariesService
    -generation ItineraryGenerationFacade
    -response ApiResponseBuilder
    +templates()
    +topRated()
    +list(user)
    +create(user, dto)
    +retrieve(user, id)
    +generate(user, id)
    +days(user, id)
    +dayDetail(user, id, dayNumber)
  }

  class FavoritesController {
    <<Controller>>
    -itineraries ItinerariesService
    -response ApiResponseBuilder
    +list(user)
    +create(user, dto)
  }

  class ReviewsController {
    <<Controller>>
    -itineraries ItinerariesService
    -response ApiResponseBuilder
    +list(itinerary)
    +create(user, dto)
  }

  class SharedLinksController {
    <<Controller>>
    -itineraries ItinerariesService
    -response ApiResponseBuilder
    +list(user)
    +create(user, dto)
  }

  class ItinerariesService {
    <<Service>>
    -itineraries Repository~Itinerary~
    -days Repository~ItineraryDay~
    -favorites Repository~FavoriteItinerary~
    -reviews Repository~Review~
    -reviewStats Repository~ReviewStat~
    -sharedLinks Repository~SharedItineraryLink~
    -audit AuditService
    +listForUser(userId) Promise~Itinerary[]~
    +findForUser(id, userId) Promise~Itinerary~
    +create(userId, dto) Promise~Itinerary~
    +markGenerating(id, userId) Promise~Itinerary~
    +templates() Promise~Itinerary[]~
    +topRated() Promise~Itinerary[]~
    +daysForItinerary(id, userId) Promise~ItineraryDay[]~
    +dayDetail(id, dayNumber, userId) Promise~ItineraryDay~
    +listFavorites(userId) Promise~FavoriteItinerary[]~
    +createFavorite(userId, dto) Promise~FavoriteItinerary~
    +listReviews(itinerary) Promise~Review[]~
    +createReview(userId, dto) Promise~Review~
    +listSharedLinks(userId) Promise~SharedItineraryLink[]~
    +createSharedLink(userId, dto) Promise~SharedItineraryLink~
  }

  class CreateItineraryDto {
    <<DTO>>
    +destination number
    +title string
    +summary string
    +start_date string
    +end_date string
    +duration_days number
    +budget_total number
    +currency_code string
  }

  class CreateReviewDto {
    <<DTO>>
    +itinerary number
    +rating number
    +title string
    +body string
  }

  class CreateFavoriteDto {
    <<DTO>>
    +itinerary number
  }

  class CreateSharedLinkDto {
    <<DTO>>
    +itinerary number
    +expires_at string
  }

  class Itinerary {
    <<Entity itineraries_itinerary>>
    +id number
    +title string
    +summary string
    +start_date string
    +end_date string
    +duration_days number
    +budget_total string
    +currency_code string
    +generation_status string
    +generation_context json
    +metadata json
    +created_at Date
    +updated_at Date
  }

  class ItineraryDay {
    <<Entity itineraries_itineraryday>>
    +id number
    +day_number number
    +title string
    +summary string
    +estimated_cost string
  }

  class ItineraryDailyEvent {
    <<Entity itineraries_itinerarydailyevent>>
    +id number
    +start_time string
    +end_time string
    +title string
    +description string
    +estimated_cost string
    +order_index number
  }

  class FavoriteItinerary {
    <<Entity itineraries_favoriteitinerary>>
    +id number
    +created_at Date
  }

  class Review {
    <<Entity itineraries_review>>
    +id number
    +rating number
    +title string
    +body string
    +created_at Date
    +updated_at Date
  }

  class ReviewStat {
    <<Entity itineraries_reviewstat>>
    +id number
    +review_count number
    +average_rating string
  }

  class SharedItineraryLink {
    <<Entity itineraries_shareditinerarylink>>
    +id number
    +token string
    +expires_at Date
    +is_active boolean
    +created_at Date
  }

  class ItineraryComponent {
    <<interface>>
    +getTitle() string
    +getEstimatedCost() number
    +toPlainObject() object
  }

  class ItineraryEventLeaf {
    <<Composite Leaf>>
    -event object
    +getTitle() string
    +getEstimatedCost() number
    +toPlainObject() object
  }

  class ItineraryDayComposite {
    <<Composite>>
    -children ItineraryComponent[]
    -day object
    +add(component) ItineraryDayComposite
    +getTitle() string
    +getEstimatedCost() number
    +toPlainObject() object
  }

  class ItineraryComposite {
    <<Composite Root>>
    -days ItineraryDayComposite[]
    -title string
    +add(day) ItineraryComposite
    +getTitle() string
    +getEstimatedCost() number
    +toPlainObject() object
  }
}

namespace AI {
  class AiModule {
    <<Module>>
  }

  class AiController {
    <<Controller>>
    -ai AiService
    -response ApiResponseBuilder
    +models()
    +jobs(user)
  }

  class AiService {
    <<Service>>
    -jobs Repository~LlmJob~
    -logs Repository~LlmJobLog~
    -models Repository~LlmModel~
    -templates Repository~PromptTemplate~
    -itineraries Repository~Itinerary~
    -days Repository~ItineraryDay~
    -events Repository~ItineraryDailyEvent~
    -profiles Repository~TravelerDnaProfile~
    -preferences Repository~UserTripPreference~
    -pois Repository~PointOfInterest~
    -generatorFactory ItineraryGeneratorFactory
    +listModels() Promise~LlmModel[]~
    +listJobs(userId) Promise~LlmJob[]~
    +createJob(itinerary, userId) Promise~LlmJob~
    +runJob(jobId) Promise~LlmJob~
  }

  class GeneratedItinerary {
    <<interface>>
    +title string
    +summary string
    +currency_code string
    +estimated_cost string
    +days array
    +metadata json
  }

  class BaseItineraryGenerator {
    <<abstract>>
    +generate(input) GeneratedItinerary
  }

  class MockItineraryGenerator {
    <<Generator>>
    +generate(input) GeneratedItinerary
  }

  class LlmProvider {
    <<Entity ai_llmprovider>>
    +id number
    +key string
    +name string
    +config json
    +is_active boolean
  }

  class LlmModel {
    <<Entity ai_llmmodel>>
    +id number
    +key string
    +name string
    +context_window number
    +is_default boolean
    +is_active boolean
  }

  class PromptTemplate {
    <<Entity ai_prompttemplate>>
    +id number
    +key string
    +name string
    +template string
    +version number
    +is_active boolean
    +metadata json
  }

  class LlmJob {
    <<Entity ai_llmjob>>
    +id number
    +job_type string
    +status string
    +request_payload json
    +response_payload json
    +error_message string
    +created_at Date
    +updated_at Date
  }

  class LlmJobLog {
    <<Entity ai_llmjoblog>>
    +id number
    +level string
    +message string
    +payload json
    +created_at Date
  }
}

namespace Audit {
  class AuditModule {
