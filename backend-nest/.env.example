DATABASE_URL=postgresql://postgres:1414@localhost:5432/viajero
JWT_SECRET_KEY=unsafe-dev-secret
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7
PORT=8001
CORS_ALLOW_ALL_ORIGINS=true

# IA. Cada dev usa a propria chave e nunca commita chave.
# groq ou gemini: provedor principal da geracao de roteiro (o outro, se tiver chave, entra como reserva).
# Sem nenhuma chave (ou com mock), o roteiro sai do gerador deterministico.
DEFAULT_LLM_PROVIDER=groq
# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT=20
GROQ_ITINERARY_TIMEOUT=40
GROQ_MAX_TOKENS=8192
# gpt-oss usa low por padrao (rapido); off desliga o parametro para modelos que nao aceitam.
GROQ_REASONING_EFFORT=
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_TIMEOUT=20
GEMINI_ITINERARY_TIMEOUT=40
GEMINI_MAX_TOKENS=8192

# Firecrawl (opcional): enriquece destinos novos com dados de guias turisticos. https://www.firecrawl.dev/
FIRECRAWL_API_KEY=
FIRECRAWL_API_URL=https://api.firecrawl.dev/v1
FIRECRAWL_SEARCH_LIMIT=4
FIRECRAWL_SEARCH_TIMEOUT=15
FIRECRAWL_SCRAPE_TIMEOUT=25
FIRECRAWL_DISCOVERY_FAILURE_TTL=60
# Tempo maximo (s) gasto no Firecrawl numa descoberta; o LLM roda em paralelo.
FIRECRAWL_DISCOVERY_BUDGET=45
